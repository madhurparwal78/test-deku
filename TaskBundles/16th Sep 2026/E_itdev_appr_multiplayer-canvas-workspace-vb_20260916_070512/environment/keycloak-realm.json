  "roles": {
    "realm": [
      {
        "name": "editor",
        "description": "Edits frames, comments, publishes a library, opens a branch"
      },
      {
        "name": "reviewer",
        "description": "Approves and merges a branch in a team the reviewer belongs to"
      },
      {
        "name": "org_admin",
        "description": "Runs members, roles, seats and identity enforcement"
      }
    ]
  },
