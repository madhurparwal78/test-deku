{
  "id": "meridian",
  "realm": "meridian",
  "displayName": "Meridian",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "permanentLockout": false,
  "roles": {
    "realm": [
      {
        "name": "developer",
        "description": "Raises promotion requests and triggers builds",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "reviewer",
        "description": "Approves or rejects promotion requests and manages firewall rules",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "finance",
        "description": "Sets budgets and spend caps and reads invoices",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "viewer",
        "description": "Reads projects, deployments and deployment status only",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "groups": [
    {
      "name": "northwind",
      "path": "/northwind",
      "subGroups": [
        {
          "name": "release-reviewers",
          "path": "/northwind/release-reviewers",
          "subGroups": []
        }
      ]
    },
    {
      "name": "atlas",
      "path": "/atlas",
      "subGroups": []
    }
  ],
  "clients": [
    {
      "clientId": "meridian-console",
      "name": "Meridian Deployment Governance Console",
      "enabled": true,
