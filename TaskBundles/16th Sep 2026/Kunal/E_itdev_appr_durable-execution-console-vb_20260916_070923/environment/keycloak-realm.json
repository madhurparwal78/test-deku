{
  "realm": "perpetua",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 3600,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 86400,
  "roles": {
    "realm": [
      { "name": "developer", "description": "Reads executions and files a change request" },
      { "name": "namespace-admin", "description": "Reviews, approves and applies a change request" },
      { "name": "owner", "description": "Organisation scope, grants roles and reads the audit trail" },
      { "name": "admin", "description": "Grantable role name, no seeded principal" },
      { "name": "read-only", "description": "Grantable role name, no seeded principal" },
      { "name": "auditor", "description": "Grantable role name, no seeded principal" }
    ]
  },
  "clients": [
    {
      "clientId": "perpetua-console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
