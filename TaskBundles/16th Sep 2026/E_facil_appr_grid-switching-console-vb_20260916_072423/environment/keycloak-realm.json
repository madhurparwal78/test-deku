{
  "realm": "deku",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 3600,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 43200,
  "offlineSessionIdleTimeout": 43200,
  "accessCodeLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "operator",
        "description": "Authors and executes switching orders inside an assigned operating area"
      },
      {
        "name": "coordinator",
        "description": "Commands incidents and approves switching orders of risk class 1 to 3"
      },
      {
        "name": "controller",
        "description": "Countersigns risk class 4 orders and publishes model versions"
      },
      {
        "name": "auditor",
        "description": "Reads the append-only record and runs chain recomputations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "switchyard-console",
      "name": "Switchyard Grid Switching Console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "switchyard-console-4f1c9d27",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "areas",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "areas",
            "claim.name": "areas",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
