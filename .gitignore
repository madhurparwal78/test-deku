node_modules/
.DS_Store

# Build/debug artifacts inside a trajectory's app -- large binaries the graded
# app downloaded at runtime, and Playwright trace zips from the rubric judge.
# Both exceed GitHub's limits (a .dmg here hit 152MB vs the 100MB hard cap) and
# neither is part of the trajectory record: the anthropic-claude-opus-5 runs
# carry no such directories.
**/app/.downloads-cache/
**/trajectories/*/run_*/traces/
